# Anthropic access for brand-fidelity validation.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# Firecrawl access for brand/site ingestion.
# Not yet handed over for this repo as of 2026-09-03.
FIRECRAWL_API_KEY=
FIRECRAWL_BASE_URL=https://api.firecrawl.dev

# Porter access for runtime deployment.
# Account setup is still in progress; placeholder values only for now.
PORTER_API_TOKEN=
PORTER_PROJECT_ID=
PORTER_CLUSTER_ID=
PORTER_ENVIRONMENT=development

# Supabase access for durable tool storage + rate-limit counters.
# Optional: if unset, falls back to file-based storage (dev only, does not
# survive multi-instance/ephemeral deploys) and an in-memory rate limiter
# (per-instance only). Run supabase/migrations/0001_init.sql against the
# project before setting these.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
