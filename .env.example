# Anthropic access for brand-fidelity validation.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# Context.dev access for brand/site ingestion.
# Mir still needs to obtain and set the production key in Porter.
CONTEXT_DEV_API_KEY=
CONTEXT_DEV_BASE_URL=https://api.context.dev/v1

# Optional absolute base URL for server-generated embed snippets when the
# incoming request origin/forwarded headers are unavailable.
TOOLBUILDER_BASE_URL=http://localhost:3000

# Porter access for runtime deployment.
# Account setup is still in progress; placeholder values only for now.
PORTER_API_TOKEN=
PORTER_PROJECT_ID=
PORTER_CLUSTER_ID=
PORTER_ENVIRONMENT=development

# Supabase access for durable tool storage + rate-limit counters.
# Optional: if unset, falls back to file-based storage (dev only, does not
# survive multi-instance/ephemeral deploys) and an in-memory rate limiter
# (per-instance only). Run supabase/migrations/0001_init.sql against the
# project before setting these.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
